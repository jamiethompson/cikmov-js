{
  "name": "cikmov-js",
  "version": "0.1.0",
  "description": "Deterministic UK postcode normalisation and correction with CIKMOV-rule parity.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "ADR.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist coverage",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@angular/core": "^20.0.0",
    "@eslint/js": "^9.23.0",
    "@types/node": "^22.13.9",
    "@types/react": "^19.1.0",
    "@vitest/coverage-v8": "^3.0.8",
    "eslint": "^9.23.0",
    "react": "^19.1.0",
    "rxjs": "^7.8.2",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0",
    "vitest": "^3.0.8",
    "vue": "^3.5.13",
    "zone.js": "^0.15.0"
  }
}
